---
import Layout from '../layouts/Layout.astro';
import Contact from '../components/Contact.astro';
---

<Layout title="Devah Schaefers" centered>
  <section class="nano-copy fade-in" aria-labelledby="intro-title">
    <h1 id="intro-title">Hi, I'm Devah</h1>

    <p>
      I'm an undergraduate at
      <a href="https://www.berkeley.edu/" target="_blank" rel="noopener noreferrer">UC Berkeley</a>
      (<span class="go-bears" data-go-bears role="button" tabindex="0" aria-label="Go bears">go bears!</span>)
      studying
      <a href="https://cdss.berkeley.edu/">Computer Science</a>
      and
      <a href="https://data.berkeley.edu/">Data Science</a>.
      I like to build
      <span class="role-rotator" data-role-rotator><span class="role-word">software.</span></span>
    </p>

    <p>
      Currently, I'm conducting ML research at
      <a href="https://neurotech.studentorg.berkeley.edu/">NeuroTech @ Berkeley</a>
      and leading engineering at
      <a href="https://openprojectberkeley.com/">Open Project</a>.
      My work spans applied ML research, high-volume data pipelines, and full-stack
      internal platforms serving hundreds of users.
    </p>

    <p>
      I work across Python, TypeScript, Rust, SQL, React/Next.js, PyTorch,
      PostgreSQL, and modern AI/LLM tooling.
      <a href="mailto:devah.schaefers@gmail.com">Email me</a>,
      <a href="https://github.com/devahschaefers">visit GitHub</a>,
      or find me on
      <a href="https://www.linkedin.com/in/devahschaefers/">LinkedIn</a>.
    </p>
  </section>

  <Contact />
</Layout>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  (() => {
    const el = document.querySelector<HTMLElement>('[data-go-bears]');
    if (!el) return;

    const pop = () => {
      if (reduceMotion) return;
      const bear = document.createElement('span');
      bear.className = 'bear-pop';
      bear.textContent = Math.random() < 0.15 ? '🐾' : '🐻';
      el.appendChild(bear);
      setTimeout(() => bear.remove(), 1200);
    };

    el.addEventListener('click', pop);
    el.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        pop();
      }
    });
  })();

  (() => {
    const host = document.querySelector<HTMLElement>('[data-role-rotator] .role-word');
    if (!host) return;

    const words = ['software.', 'LLM agents.', 'EEG models.', 'data tooling.', 'AI systems.', 'data infrastructure.'];
    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));

    if (reduceMotion) {
      let i = 0;
      setInterval(() => {
        i = (i + 1) % words.length;
        host.textContent = words[i];
      }, 4000);
      return;
    }

    let i = 0;
    (async function cycle() {
      await sleep(2200);
      while (true) {
        const current = host.textContent ?? '';
        const next = words[(i + 1) % words.length];
        for (let j = current.length; j >= 0; j--) {
          host.textContent = current.slice(0, j);
          await sleep(28);
        }
        await sleep(120);
        for (let j = 0; j <= next.length; j++) {
          host.textContent = next.slice(0, j);
          await sleep(48);
        }
        i = (i + 1) % words.length;
        await sleep(2200);
      }
    })();
  })();
</script>
