---
import Layout from '../../../layouts/Layout.astro';
import Contact from '../../../components/Contact.astro';
import { categories } from '../../../data/experience';
import { FULL_POSTS, getWorkPostSlug, groupWorkPosts } from '../../../data/workContent';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const { posts: workPosts, tldrBySlug } = groupWorkPosts(await getCollection('work'));

  return workPosts.flatMap((post) =>
    post.data.categories.map((category) => {
      const cat = categories.find((item) => item.id === category);
      const postSlug = getWorkPostSlug(post);

      return {
        params: { category, post: postSlug },
        props: { cat, post, postSlug, tldrPost: tldrBySlug.get(postSlug) },
      };
    }),
  );
}

const { cat, post, postSlug, tldrPost } = Astro.props;
const renderedTldr = tldrPost ? await render(tldrPost) : null;
const TldrContent = renderedTldr?.Content;
const experience = cat.experiences.find((entry) => entry.postSlug === postSlug);
const canReadFull = FULL_POSTS.has(postSlug);
const shouldRenderFull = canReadFull || !TldrContent;
const renderedFull = shouldRenderFull ? await render(post) : null;
const Content = renderedFull?.Content;
const initialWorkMode = canReadFull || !TldrContent ? 'full' : 'tldr';
---

<Layout title={`Devah Schaefers — ${post.data.title}`} description={post.data.blurb} current="experience">
  <article
    class="work-page"
    data-work-reader
    data-work-mode={initialWorkMode}
    data-work-full-available={String(canReadFull)}
  >
    <header class="work-page-header">
      <div class="work-page-topline">
        <a href={`/experience/${cat.id}`} class="link-internal">
          ← Back to {cat.label}
        </a>

        {TldrContent && (
          <div class="tldr-toggle" role="group" aria-label="Reading mode">
            <button
              type="button"
              class:list={['tldr-toggle__button', { 'is-active': initialWorkMode === 'full', 'is-disabled': !canReadFull }]}
              data-work-mode-button="full"
              aria-pressed={String(initialWorkMode === 'full')}
              aria-disabled={String(!canReadFull)}
              disabled={!canReadFull}
            >
              Full
            </button>
            <button
              type="button"
              class:list={['tldr-toggle__button', { 'is-active': initialWorkMode === 'tldr' }]}
              data-work-mode-button="tldr"
              aria-pressed={String(initialWorkMode === 'tldr')}
            >
              TLDR
            </button>
          </div>
        )}
      </div>

      <div class="flex flex-col items-start gap-1">
        <div class="work-page-kicker">
          <span
            transition:name={`work-category-label-${cat.id}`}
            class="work-row-title--transition"
          >
            {cat.label}
          </span>
          <span>/</span>
        </div>

        {experience ? (
          <div
            transition:name={`work-experience-line-${cat.id}-${postSlug}`}
            class="work-row-title--transition work-page-meta"
          >
            {experience.role} @ {experience.company} · {experience.dates}
          </div>
        ) : (
          <h1
            transition:name={`work-post-title-${cat.id}-${postSlug}`}
            class="section-heading inline-block max-w-full mb-0!"
          >
            {post.data.title}
          </h1>
        )}
      </div>

      {experience && (
        <h1 class="section-heading work-page-title inline-block max-w-full mb-0!">
          {post.data.title}
        </h1>
      )}
    </header>

    {Content && (
      <div
        class="work-post work-copy"
        data-work-copy="full"
        hidden={initialWorkMode !== 'full'}
        aria-hidden={String(initialWorkMode !== 'full')}
      >
        <Content />
      </div>
    )}

    {TldrContent && (
      <div
        class="work-post work-copy work-copy--tldr"
        data-work-copy="tldr"
        hidden={initialWorkMode !== 'tldr'}
        aria-hidden={String(initialWorkMode !== 'tldr')}
      >
        <TldrContent />
      </div>
    )}

    <div class="work-page-related">
      {post.data.categories
        .filter((category) => category !== cat.id)
        .map((category) => categories.find((item) => item.id === category))
        .filter(Boolean)
        .map((category) => (
          <a href={`/experience/${category.id}/${postSlug}`} class="link-internal">
            Also in {category.label} →
          </a>
        ))}
    </div>
  </article>

  <Contact />

  <script>
    const setupWorkModeToggles = () => {
      document.querySelectorAll('[data-work-reader]').forEach((root) => {
        if (!(root instanceof HTMLElement) || root.dataset.workToggleReady === 'true') return;

        const buttons = Array.from(root.querySelectorAll('[data-work-mode-button]'));
        const copies = Array.from(root.querySelectorAll('[data-work-copy]'));
        root.dataset.workToggleReady = 'true';

        const fullAvailable = root.dataset.workFullAvailable === 'true';

        const setMode = (mode) => {
          const nextMode = mode === 'tldr' ? 'tldr' : 'full';
          const availableMode = nextMode === 'full' && !fullAvailable ? 'tldr' : nextMode;
          root.dataset.workMode = availableMode;

          buttons.forEach((button) => {
            if (!(button instanceof HTMLButtonElement)) return;
            const isActive = button.dataset.workModeButton === availableMode;
            button.classList.toggle('is-active', isActive);
            button.setAttribute('aria-pressed', String(isActive));
          });

          copies.forEach((copy) => {
            if (!(copy instanceof HTMLElement)) return;
            const isActive = copy.dataset.workCopy === availableMode;
            copy.hidden = !isActive;
            copy.setAttribute('aria-hidden', String(!isActive));
          });
        };

        let savedMode = fullAvailable ? 'full' : 'tldr';

        try {
          savedMode = fullAvailable ? (window.localStorage.getItem('work-reading-mode') ?? 'full') : 'tldr';
        } catch {
          savedMode = fullAvailable ? 'full' : 'tldr';
        }

        setMode(savedMode);

        buttons.forEach((button) => {
          button.addEventListener('click', () => {
            if (!(button instanceof HTMLButtonElement)) return;
            if (button.disabled) return;
            const mode = button.dataset.workModeButton ?? 'full';
            setMode(mode);

            try {
              window.localStorage.setItem('work-reading-mode', mode);
            } catch {
              // Ignore storage failures; the switch still works for this page view.
            }
          });
        });
      });
    };

    setupWorkModeToggles();

    if (document.documentElement.dataset.workToggleBound !== 'true') {
      document.documentElement.dataset.workToggleBound = 'true';
      document.addEventListener('astro:page-load', setupWorkModeToggles);
    }
  </script>
</Layout>
