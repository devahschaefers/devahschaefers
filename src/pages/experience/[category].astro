---
import Layout from '../../layouts/Layout.astro';
import Contact from '../../components/Contact.astro';
import { categories } from '../../data/experience';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const workPosts = await getCollection('work');

  return categories.map((cat) => ({
    params: { category: cat.id },
    props: {
      cat,
      posts: workPosts
        .filter((post) => post.data.categories.includes(cat.id))
        .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title)),
    },
  }));
}

const { cat, posts } = Astro.props;
const postBySlug = new Map(posts.map((post) => [post.id, post]));
---

<Layout title={`Devah Schaefers — ${cat.label} Experience`} description={cat.tagline} current="experience">

  <section class="pb-10">
    <a href="/experience" class="link-internal mb-6">
      ← Back to experience
    </a>

    <div class="inline-flex w-fit max-w-full flex-wrap items-baseline gap-x-3 gap-y-1 mb-8">
      <h2
        transition:name={`work-category-label-${cat.id}`}
        class="section-heading inline-block mb-0!"
      >
        {cat.label}
      </h2>
      <p
        transition:name={`work-category-tagline-${cat.id}`}
        class="text-text-secondary text-sm inline-block"
      >
        {cat.tagline}
      </p>
    </div>

    <div>
      {cat.experiences.map((exp) => (
        <a
          href={exp.postSlug ? `/experience/${cat.id}/${exp.postSlug}` : undefined}
          class:list={['work-row', exp.postSlug && 'work-row--linked']}
        >
          <span class="work-row-title">
            <span
              transition:name={exp.postSlug ? `work-experience-line-${cat.id}-${exp.postSlug}` : undefined}
              class="work-row-title--transition"
            >
              {exp.role}
              <span class="work-row-context"> @ {exp.company} · {exp.dates}</span>
            </span>
            <span class="work-row-description">{exp.summary}</span>
          </span>
        </a>
      ))}
    </div>

    {cat.projects.length > 0 && (
      <div class="mt-12">
        <h3 class="text-xs font-medium text-text-muted tracking-wide uppercase mb-4">Projects</h3>
        <div>
          {cat.projects.map((project) => (
            <a
              href={project.postSlug ? `/experience/${cat.id}/${project.postSlug}` : undefined}
              class:list={['work-row', project.postSlug && 'work-row--linked']}
            >
              <span
                transition:name={project.postSlug ? `work-post-title-${cat.id}-${project.postSlug}` : undefined}
                class="work-row-title work-row-title--transition"
              >
                {project.title}
                {postBySlug.get(project.postSlug)?.data.draft && <span class="work-row-context"> · Draft</span>}
              </span>
            </a>
          ))}
        </div>
      </div>
    )}

    <div class="mt-8 pt-6 border-t border-border flex flex-wrap gap-3">
      {categories.filter((c) => c.id !== cat.id).map((c) => (
        <a href={`/experience/${c.id}`} class="link-internal">
          {c.label} →
        </a>
      ))}
    </div>
  </section>

  <Contact />
</Layout>
