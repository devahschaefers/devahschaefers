---
// Home-page-only animated signature for the bottom of the page.
// Uses a left-to-right clip-path reveal + a small accent-colored pen dot
// that rides the reveal edge.
// The animation triggers when the signature scrolls into view via
// IntersectionObserver, so it lands as a natural "sign-off" moment
// rather than firing off-screen when the page first loads.
---

<div class="signature-wrap" aria-label="— Devah" data-signature>
  <span class="signature" aria-hidden="true">
    <span class="signature-ink">— Devah</span>
    <span class="signature-pen" aria-hidden="true"></span>
  </span>
</div>

<script>
  // Re-run on every view-transition swap, not just first load: a module script
  // won't re-execute on client-side navigations, so without this the swapped-in
  // signature never gets its observer and stays hidden until a hard refresh.
  let io: IntersectionObserver | undefined;

  function initSignature() {
    io?.disconnect();

    const wrap = document.querySelector<HTMLElement>('[data-signature]');
    if (!wrap) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduceMotion) {
      wrap.classList.add('signature--drawn');
      return;
    }

    // Trigger the draw-in the first time the signature enters the viewport.
    // On short pages it's already visible on load, so the observer fires
    // immediately and animates with its CSS delay.
    io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            wrap.classList.add('signature--playing');
            io?.disconnect();
            break;
          }
        }
      },
      { threshold: 0.4 }
    );
    io.observe(wrap);
  }

  document.addEventListener('astro:page-load', initSignature);
  document.addEventListener('astro:before-swap', () => io?.disconnect());
</script>

<style>
  /* Left-to-right clip-path reveal with a small accent-colored pen dot
     tracking the edge. The animation only runs when the wrap gets a
     `.signature--playing` class (applied by IntersectionObserver when the
     element scrolls into view). `.signature--drawn` snaps it to the finished
     state without animation (used for prefers-reduced-motion). */

  .signature-wrap {
    display: flex;
    justify-content: center;
    margin: 0.5rem 0 1rem;
    color: var(--color-text-secondary);
    user-select: none;
  }

  .signature {
    position: relative;
    display: inline-block;
    font-family: var(--font-accent);
    font-style: italic;
    font-weight: 500;
    font-size: 2rem;
    line-height: 1;
    letter-spacing: 0;
    transform: rotate(-3deg);
    transform-origin: left center;
  }

  .signature-ink {
    display: inline-block;
    /* Start fully clipped from the right — nothing shows until the
       `.signature--playing` class gets added, which runs the reveal. */
    clip-path: inset(0 100% 0 0);
    will-change: clip-path;
  }

  .signature-pen {
    position: absolute;
    left: 0;
    top: 55%;
    width: 5px;
    height: 5px;
    border-radius: 9999px;
    background: var(--color-pop);
    box-shadow: 0 0 10px color-mix(in oklch, var(--color-pop) 70%, transparent);
    transform: translate(-2px, -50%);
    opacity: 0;
    pointer-events: none;
    will-change: left, opacity;
  }

  .signature--playing .signature-ink {
    animation: signature-draw 1.5s cubic-bezier(0.65, 0, 0.35, 1) 0.15s forwards;
  }

  .signature--playing .signature-pen {
    animation: signature-pen 1.5s cubic-bezier(0.65, 0, 0.35, 1) 0.15s forwards;
  }

  .signature--drawn .signature-ink {
    clip-path: inset(0 0% 0 0);
  }

  @keyframes signature-draw {
    from { clip-path: inset(0 100% 0 0); }
    to   { clip-path: inset(0 0% 0 0); }
  }

  @keyframes signature-pen {
    0%   { left: 0;    opacity: 0; }
    8%   { opacity: 1; }
    92%  { opacity: 1; }
    100% { left: 100%; opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .signature-ink { animation: none !important; clip-path: inset(0 0% 0 0); }
    .signature-pen { display: none; }
  }
</style>
