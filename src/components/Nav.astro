---
interface Props {
  current?: string;
}

const { current = 'home' } = Astro.props;

const links = [
  { href: '/', label: 'Home', key: 'home' },
  { href: '/experience', label: 'Work', key: 'experience' },
  { href: '/blogs', label: 'Blogs', key: 'blogs' },
  { href: '/classes', label: 'Classes', key: 'classes' },
];
---

<aside class="mb-6 tracking-tight">
  <div class="lg:sticky lg:top-20">
    <nav class="flex items-center justify-center relative px-0 pb-0 py-3">
      <div class="flex flex-wrap md:flex-nowrap items-center justify-center gap-x-4 gap-y-2 w-full md:w-auto">
        {links.map(({ href, label, key }) => (
          <a
            href={href}
            class:list={['nav-link', current === key && 'active']}
          >
            {label}
          </a>
        ))}
      </div>
    </nav>
  </div>
</aside>

<style>
  .nav-link {
    position: relative;
    display: inline-block;
    padding: 3px 10px 5px;
    border-radius: 6px;
    text-decoration: none;
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: 0.9rem;
    letter-spacing: 0.01em;
    color: var(--color-text-secondary);
    transition: color 0.15s ease,
                transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .nav-link:hover {
    color: var(--color-text);
    transform: scale(1.05);
  }

  .nav-link.active {
    color: var(--color-pop);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    left: 25%;
    right: 25%;
    bottom: 2px;
    height: 2px;
    border-radius: 9999px;
    background-color: var(--color-pop);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .nav-link.active::after {
    transform: scaleX(1);
  }
</style>
