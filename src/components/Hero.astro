---
const name = 'Devah';
---

<section class="mb-8 fade-in" id="hero">
  <div class="flex flex-col items-center">
    <div class="leading-relaxed text-text space-y-6 md:space-y-4 md:max-w-4xl text-left">
      <h1 class="hero-heading mb-4 text-text text-center">
        <span class="greeting" data-greeting>Hi!</span> I'm
        <span class="hero-name" aria-label={name}>
          {name.split('').map((ch) => (
            <span class="wave-letter" aria-hidden="true">{ch}</span>
          ))}
        </span>
      </h1>

      <div>
        I'm an undergraduate @
        <a href="https://www.berkeley.edu/" target="_blank" rel="noopener noreferrer" class="link-external">UC Berkeley</a>
        (<span class="go-bears" data-go-bears role="button" tabindex="0" aria-label="Go bears">go bears!</span>) studying
        <a href="https://cdss.berkeley.edu/" class="link-external">Computer Science</a>
        and
        <a href="https://data.berkeley.edu/" class="link-external">Data Science</a>.
        <br>

      </div>
      <p>
          I like to build <span class="role-rotator" data-role-rotator><span class="role-word">software.</span></span>
      </p>
      <!-- <p>
        My work spans LLM-powered agents, applied ML research on EEG data for
        brain-computer interfaces, high-volume data pipelines, and full-stack
        internal platforms serving hundreds of users. I work across Python,
        TypeScript, Rust, SQL, React/Next.js, PyTorch, PostgreSQL, and modern AI/LLM tooling.
      </p> -->

      <p>
        Currently, I'm conducting ML research at
        <a href="https://neurotech.studentorg.berkeley.edu/" class="link-external">NeuroTech @ Berkeley</a>
        and leading engineering at
        <a href="https://openprojectberkeley.com/" class="link-external">Open Project</a>.
      </p>
    </div>
  </div>
</section>

<script>
  // Respect reduced-motion for every decorative JS effect
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Generation token: every (re)init bumps it, and the long-running rotator
  // loops bail out as soon as their captured token goes stale. Without this,
  // module scripts don't re-run on view-transition navigations, so the rotator
  // would keep mutating a detached node forever after you leave home — and the
  // greeting / "go bears" handlers would never re-attach to the swapped DOM.
  let generation = 0;
  let rotatorInterval: number | undefined;

  function stopHero() {
    generation++;
    if (rotatorInterval !== undefined) {
      clearInterval(rotatorInterval);
      rotatorInterval = undefined;
    }
  }

  function initHero() {
    // Invalidate any rotator loop/interval still running from a prior page.
    stopHero();
    const gen = generation;

    // ── Time-aware greeting ──
    const greetEl = document.querySelector<HTMLElement>('[data-greeting]');
    if (greetEl) {
      const h = new Date().getHours();
      let msg = 'Hi!';
      if (h >= 5 && h < 12) msg = 'Good morning!';
      else if (h >= 12 && h < 17) msg = 'Good afternoon!';
      else if (h >= 17 && h < 22) msg = 'Good evening!';
      else msg = 'Hi!'; // think of some creative late-night greeetings
      greetEl.textContent = msg;
    }

    // ── "go bears!" — pop a tiny bear on click ──
    // Listeners live on the element itself, so they're GC'd with the old DOM
    // on swap; re-running simply binds the fresh element.
    const bearsEl = document.querySelector<HTMLElement>('[data-go-bears]');
    if (bearsEl) {
      const pop = () => {
        if (reduceMotion) return;
        const bear = document.createElement('span');
        bear.className = 'bear-pop';
        bear.textContent = Math.random() < 0.15 ? '🐾' : '🐻';
        bearsEl.appendChild(bear);
        setTimeout(() => bear.remove(), 1200);
      };

      bearsEl.addEventListener('click', pop);
      bearsEl.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          pop();
        }
      });
    }

    // ── Rotating role word — typewriter rhythm ──
    const host = document.querySelector<HTMLElement>('[data-role-rotator] .role-word');
    if (!host) return;

    const words = ['LLM agents.', 'EEG models.', 'data tooling.', 'AI systems.', 'data infrastructure.'];

    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));

    // If reduced motion, just cycle a simple swap every 4s with no typing
    if (reduceMotion) {
      let i = 0;
      rotatorInterval = window.setInterval(() => {
        i = (i + 1) % words.length;
        host.textContent = words[i];
      }, 4000);
      return;
    }

    let i = 0;
    (async function cycle() {
      // Initial pause so visitors read the first word
      await sleep(2400);
      while (gen === generation) {
        const current = host.textContent ?? '';
        const next = words[(i + 1) % words.length];

        // Erase
        for (let j = current.length; j >= 0 && gen === generation; j--) {
          host.textContent = current.slice(0, j);
          await sleep(32);
        }
        if (gen !== generation) break;
        await sleep(120);
        // Type
        for (let j = 0; j <= next.length && gen === generation; j++) {
          host.textContent = next.slice(0, j);
          await sleep(55);
        }
        i = (i + 1) % words.length;
        await sleep(2400);
      }
    })();
  }

  document.addEventListener('astro:page-load', initHero);
  document.addEventListener('astro:before-swap', stopHero);
</script>

<style>
  #hero {
    margin-bottom: 2rem;
  }

  #hero .leading-relaxed {
    max-width: 42rem;
    color: var(--color-text-secondary);
    font-size: 1rem;
    line-height: 1.82;
  }

  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .fade-in {
    animation: fadeInUp 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  }

  .hero-heading {
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.82;
    letter-spacing: 0;
    text-align: left;
  }

  .hero-name {
    font-family: var(--font-body);
    font-style: normal;
    font-size: 1em;
    font-weight: 700;
    color: var(--color-pop);
    display: inline-block;
    cursor: default;
  }

  /* Per-letter wave — each letter is wrapped in a .wave-letter span */
  .wave-letter {
    display: inline-block;
    will-change: transform;
  }

  @media (hover: hover) {
    .hero-name:hover .wave-letter {
      animation: wave-letter-pop 0.72s cubic-bezier(0.34, 1.56, 0.64, 1) both;
    }
    .hero-name:hover .wave-letter:nth-child(1) { animation-delay: 0ms; }
    .hero-name:hover .wave-letter:nth-child(2) { animation-delay: 70ms; }
    .hero-name:hover .wave-letter:nth-child(3) { animation-delay: 140ms; }
    .hero-name:hover .wave-letter:nth-child(4) { animation-delay: 210ms; }
    .hero-name:hover .wave-letter:nth-child(5) { animation-delay: 280ms; }
    .hero-name:hover .wave-letter:nth-child(6) { animation-delay: 350ms; }
    .hero-name:hover .wave-letter:nth-child(7) { animation-delay: 420ms; }
    .hero-name:hover .wave-letter:nth-child(8) { animation-delay: 490ms; }
  }

  @keyframes wave-letter-pop {
    0%, 100% {
      transform: translateY(0) rotate(0deg);
    }
    45% {
      transform: translateY(-6px) rotate(-4deg);
    }
  }

  /* Greeting wrapper — time-aware phrase */
  .greeting {
    display: inline-block;
    color: inherit;
    font-weight: inherit;
  }

  /* Rotating role word in hero body */
  .role-rotator {
    display: inline-block;
    position: relative;
    color: var(--color-text-secondary);
    font-style: italic;
    font-weight: inherit;
    white-space: nowrap;
  }

  .role-rotator::after {
    content: "";
    display: inline-block;
    width: 2px;
    height: 0.95em;
    margin-left: 2px;
    vertical-align: -0.1em;
    background-color: var(--color-pop);
    animation: caretBlink 1s steps(1) infinite;
  }

  @keyframes caretBlink {
    50% { opacity: 0; }
  }

  /* "go bears!" click target */
  .go-bears {
    position: relative;
    display: inline-block;
    cursor: pointer;
    user-select: none;
    color: inherit;
    transition: color 0.15s ease, transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .go-bears:hover {
    color: var(--color-pop);
    transform: translateY(-1px) rotate(-1.5deg);
  }

  /* :global — the bear spans are created by the click handler at runtime,
     so they never receive Astro's scope class. */
  .go-bears :global(.bear-pop) {
    position: absolute;
    left: 50%;
    top: 0;
    font-size: 1.3em;
    pointer-events: none;
    opacity: 0;
    transform: translate(-50%, 0);
    animation: bearPop 1.1s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  @keyframes bearPop {
    0% { opacity: 0; transform: translate(-50%, 0) scale(0.4) rotate(-8deg); }
    30% { opacity: 1; transform: translate(-50%, -28px) scale(1.15) rotate(6deg); }
    100% { opacity: 0; transform: translate(-50%, -60px) scale(0.9) rotate(-4deg); }
  }

  /* Reduced motion — kill the decorative animations */
  @media (prefers-reduced-motion: reduce) {
    .wave-letter { animation: none !important; transform: none !important; }
    .role-rotator::after { animation: none; }
    .go-bears :global(.bear-pop) { animation: none; display: none; }
  }
</style>
